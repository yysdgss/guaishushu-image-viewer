<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>怪叔叔看图安装程序</AssemblyName>
    <AssemblyTitle>怪叔叔看图 安装程序</AssemblyTitle>
    <FileDescription>怪叔叔看图 安装程序</FileDescription>
    <Company>怪叔叔</Company>
    <RootNamespace>WBInstaller</RootNamespace>
    <ApplicationIcon>..\WBImageViewer\Assets\app.ico</ApplicationIcon>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>

  <ItemGroup>
    <!-- One shared format list for viewer, association registration and installer. -->
    <Compile Include="..\WBImageViewer\Models\SupportedFormats.cs" Link="SupportedFormats.cs" />
    <Compile Include="..\WBImageViewer\Services\DefaultAssociationService.cs" Link="DefaultAssociationService.cs" />
    <EmbeddedResource Include="..\..\LICENSE" LogicalName="LICENSE.txt" />
    <EmbeddedResource Include="..\WBImageViewer\Assets\app.ico" LogicalName="AppIcon.ico" />
    <EmbeddedResource Include="..\WBImageViewer\Assets\app.png" LogicalName="AppLogo.png" />
  </ItemGroup>

  <ItemGroup>
    <!-- The packaging batch publishes the viewer here before building the installer. -->
    <EmbeddedResource Include="..\..\artifacts\setup-stage\怪叔叔看图.exe"
                      LogicalName="ViewerExe.bin"
                      Condition="Exists('..\..\artifacts\setup-stage\怪叔叔看图.exe')" />
  </ItemGroup>

</Project>
