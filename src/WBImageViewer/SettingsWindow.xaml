<Window x:Class="WBImageViewer.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="怪叔叔看图 - 后台设置"
        Icon="Assets/app.ico"
        Width="520" SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="#FFF7F8FA"
        FontSize="13">

    <StackPanel Margin="18,16,18,18">
        <TextBlock Text="运行方式" FontWeight="SemiBold" Margin="0,0,0,6" />
        <CheckBox x:Name="SingleWindowBox" Content="单窗口模式：新图片替换当前面板（关闭则每打开一张图片开一个新面板）" Margin="0,0,0,14" />

        <TextBlock Text="拖动窗口的方式（悬停在图片上）" FontWeight="SemiBold" Margin="0,0,0,6" />
        <ComboBox x:Name="MoveModeBox" Margin="0,0,0,14">
            <ComboBoxItem Content="鼠标右键拖动（默认）" Tag="RightButton" />
            <ComboBoxItem Content="按住鼠标滚轮 / 中键拖动" Tag="MiddleButton" />
            <ComboBoxItem Content="按住空格 + 鼠标左键拖动" Tag="SpaceAndLeftButton" />
        </ComboBox>

        <TextBlock Text="全局快捷键（点击输入框后直接按下组合键，Esc 清空）" FontWeight="SemiBold" Margin="0,0,0,6" />
        <Grid Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="190" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" Text="切换置顶显示" VerticalAlignment="Center" />
            <TextBox x:Name="TopMostBox" Grid.Row="0" Grid.Column="1" Margin="0,0,0,5" />

            <TextBlock Grid.Row="1" Grid.Column="0" Text="窗口贴合当前图片大小" VerticalAlignment="Center" />
            <TextBox x:Name="FitWindowBox" Grid.Row="1" Grid.Column="1" Margin="0,0,0,5" />

            <TextBlock Grid.Row="2" Grid.Column="0" Text="图片平铺到当前窗口" VerticalAlignment="Center" />
            <TextBox x:Name="FitImageBox" Grid.Row="2" Grid.Column="1" Margin="0,0,0,5" />

            <TextBlock Grid.Row="3" Grid.Column="0" Text="按住修饰键 + 滚轮：窗口随图片一起缩放" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,8,0" />
            <ComboBox x:Name="WheelModifierBox" Grid.Row="3" Grid.Column="1">
                <ComboBoxItem Content="Ctrl（默认）" Tag="Ctrl" />
                <ComboBoxItem Content="Shift" Tag="Shift" />
                <ComboBoxItem Content="Alt" Tag="Alt" />
                <ComboBoxItem Content="Shift + Ctrl" Tag="Shift+Ctrl" />
                <ComboBoxItem Content="Ctrl + Alt" Tag="Ctrl+Alt" />
                <ComboBoxItem Content="Shift + Alt" Tag="Shift+Alt" />
            </ComboBox>
        </Grid>

        <TextBlock Text="滚轮缩放步长（大于 1，例如 1.2）" FontWeight="SemiBold" Margin="0,0,0,6" />
        <TextBox x:Name="ZoomStepBox" Margin="0,0,0,14" />

        <TextBlock Text="面板圆角半径（0 - 24，0 为直角，由 DWM 绘制抗锯齿边缘）" FontWeight="SemiBold" Margin="0,0,0,6" />
        <TextBox x:Name="CornerRadiusBox" Margin="0,0,0,14" />

        <TextBlock Text="面板背景颜色（#RRGGBB）" FontWeight="SemiBold" Margin="0,0,0,6" />
        <Grid Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="140" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="BackgroundColorBox" />
            <Button Grid.Column="1" Content="选择颜色…" HorizontalAlignment="Left" Margin="10,0,0,0"
                    Padding="12,4" Click="PickColor_Click" />
        </Grid>

        <TextBlock x:Name="OpacityLabel" Text="面板背景不透明度 100%（图片不受影响）" FontWeight="SemiBold" Margin="0,0,0,6" />
        <Slider x:Name="OpacitySlider" Minimum="0.2" Maximum="1" SmallChange="0.05" LargeChange="0.1"
                Margin="0,0,0,14" ValueChanged="OpacitySlider_ValueChanged" />

        <CheckBox x:Name="AutoOptimizeBox" Content="打开图片时自动应用智能优化预设（全部归零即恢复原始图片）"
                  Margin="0,0,0,14" />

        <CheckBox x:Name="AssociateBox" Content="注册为系统默认图片查看器（启动本软件时自动应用）" Margin="0,0,0,4" />
        <TextBlock Text="Windows 会保护用户的默认选择；点击下方按钮，在弹出的“打开方式”中选中 WB 参考图一次即可。" Foreground="#FF6B7280" FontSize="11" Margin="21,0,0,8" />
        <Button Content="打开 Windows 默认程序选择对话框" HorizontalAlignment="Left" Padding="12,6" Margin="21,0,0,14" Click="ChooseDefault_Click" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="保存" Width="88" Padding="10,6" IsDefault="True" Click="Save_Click" />
            <Button Content="取消" Width="88" Padding="10,6" Margin="10,0,0,0" IsCancel="True" />
        </StackPanel>
    </StackPanel>
</Window>
