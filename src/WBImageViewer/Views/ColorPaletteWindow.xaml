<Window x:Class="WBImageViewer.Views.ColorPaletteWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="调色板" Width="360" Height="330" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" Background="#FF161A21"
        Foreground="#FFE8EAED" Icon="../Assets/app.ico">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock Text="选择笔迹颜色" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,12" />
        <UniformGrid x:Name="SwatchGrid" Grid.Row="1" Columns="6" Margin="0,0,0,12" />
        <GroupBox Grid.Row="2" Header="自定义颜色 (#RRGGBB)" Padding="8" Margin="0,0,0,12">
            <DockPanel>
                <Border x:Name="Preview" Width="34" Height="28" CornerRadius="5"
                        BorderBrush="#66FFFFFF" BorderThickness="1" Margin="0,0,10,0"
                        DockPanel.Dock="Left" Background="#FFFF4040" />
                <TextBox x:Name="HexBox" Text="#FF4040" VerticalContentAlignment="Center"
                         FontFamily="Consolas" FontSize="13" />
            </DockPanel>
        </GroupBox>
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="取消" Width="78" Margin="0,0,8,0" Padding="8,5" Click="Cancel_Click" />
            <Button Content="确定" Width="78" Padding="8,5" IsDefault="True" Click="Ok_Click" />
        </StackPanel>
    </Grid>
</Window>
