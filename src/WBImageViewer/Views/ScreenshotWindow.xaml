<Window x:Class="WBImageViewer.Views.ScreenshotWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="屏幕截图" WindowStyle="None" AllowsTransparency="True"
        Background="#00000000" ShowInTaskbar="False" Topmost="True"
        Cursor="Cross" Loaded="Window_Loaded">
    <Grid x:Name="Root">
        <!-- Pristine screen snapshot taken before the overlay opened. The crop always
             comes from this bitmap, never from the live (dimmed) screen. -->
        <Image x:Name="ScreenBackdrop" Stretch="Fill" IsHitTestVisible="False" />

        <!-- Dimming made of four plain rectangles around the selection hole.
             No StreamGeometry is used anywhere in this window: its context used to be
             disposed while WPF was still rendering, which surfaced as a random
             "Cannot access a disposed object: ByteStreamGeometryContext" crash. -->
        <Canvas x:Name="DimCanvas" IsHitTestVisible="False">
            <Rectangle x:Name="DimTop" Fill="#AA000000" />
            <Rectangle x:Name="DimBottom" Fill="#AA000000" />
            <Rectangle x:Name="DimLeft" Fill="#AA000000" />
            <Rectangle x:Name="DimRight" Fill="#AA000000" />
        </Canvas>

        <Canvas x:Name="SelectionCanvas">
            <Border x:Name="SelectionRect" Visibility="Collapsed" IsHitTestVisible="False"
                    BorderBrush="#FF6CB6FF" BorderThickness="1.5" Background="#143464FF" />
            <Polyline x:Name="SelectionFree" Visibility="Collapsed" IsHitTestVisible="False"
                      Stroke="#FF6CB6FF" StrokeThickness="1.5" Fill="#143464FF"
                      StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
            <Border x:Name="SizeTip" Visibility="Collapsed" IsHitTestVisible="False"
                    Background="#E610141A" BorderBrush="#55FFFFFF" BorderThickness="1" CornerRadius="4" Padding="4,2">
                <TextBlock x:Name="SizeText" Foreground="White" FontSize="11" FontFamily="Consolas" />
            </Border>
            <Border x:Name="Toolbar" Visibility="Collapsed" CornerRadius="8"
                    Background="#EE101418" BorderBrush="#55FFFFFF" BorderThickness="1" Padding="6">
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="ConfirmButton" Content="✓ 确定" Width="64" Margin="0,0,6,0"
                            Foreground="White" Background="#FF2E7D5B" BorderThickness="0" Padding="6,4"
                            Cursor="Hand" Click="Confirm_Click" />
                    <Button x:Name="CancelButton" Content="✕ 取消" Width="64"
                            Foreground="White" Background="#FF9C3B3B" BorderThickness="0" Padding="6,4"
                            Cursor="Hand" Click="Cancel_Click" />
                </StackPanel>
            </Border>
        </Canvas>
        <TextBlock x:Name="HintText" Text="按住鼠标左键拖动框选区域，Esc 取消"
                   HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,28,0,0"
                   FontSize="14" Foreground="White">
            <TextBlock.Effect><DropShadowEffect Color="Black" BlurRadius="6" ShadowDepth="1" /></TextBlock.Effect>
        </TextBlock>
    </Grid>
</Window>
