<Window x:Class="WBImageViewer.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="关于 怪叔叔看图"
        Icon="Assets/app.ico"
        Width="620" Height="520"
        MinWidth="480" MinHeight="420"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="#FFF7F8FA"
        FontSize="13">

    <Grid Margin="20,16,20,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
            <Border Width="46" Height="46" CornerRadius="10" Background="#FFF1F3F5" Margin="0,0,12,0">
                <Image Source="pack://application:,,,/Assets/app.png" Width="46" Height="46"
                       Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" />
            </Border>
            <StackPanel VerticalAlignment="Center">
                <TextBlock x:Name="ProductName" Text="怪叔叔看图" FontSize="20" FontWeight="SemiBold" />
                <TextBlock x:Name="VersionText" Text="版本" Foreground="#FF6B7280" Margin="0,2,0,0" />
            </StackPanel>
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="功能" FontWeight="SemiBold" Margin="0,0,0,6" />
                <TextBlock TextWrapping="Wrap" LineHeight="21" Foreground="#FF30343B">
                    无边框置顶参考面板；滚轮以鼠标为中心缩放；左键拖动平移；右键 / 中键 / 空格+左键移动窗口；
                    窗口与图片互相适配；四边四角原生缩放；单 / 多窗口模式；系统默认图片关联；
                    背景色与面板背景透明度（图片不受影响）；亮度、对比度、饱和度、去噪、锐化调整与智能优化。
                </TextBlock>

                <TextBlock Text="支持的格式" FontWeight="SemiBold" Margin="0,14,0,6" />
                <TextBlock x:Name="FormatsText" TextWrapping="Wrap" LineHeight="21"
                           Foreground="#FF30343B" />

                <TextBlock Text="操作方法" FontWeight="SemiBold" Margin="0,14,0,6" />
                <TextBlock TextWrapping="Wrap" LineHeight="21" Foreground="#FF30343B">
                    <Run Text="• 滚轮：以鼠标位置为中心缩放图片，窗口大小不变。" /><LineBreak />
                    <Run Text="• Ctrl + 滚轮：图片与窗口同步缩放。" /><LineBreak />
                    <Run Text="• 左键拖动：平移图片，放大后查看局部。" /><LineBreak />
                    <Run Text="• 右键拖动：使用 Windows 系统手型抓取光标移动整个面板（可在设置中改为中键或空格+左键）。" /><LineBreak />
                    <Run Text="• Shift+Ctrl+Alt+T / R / S：置顶 / 窗口适配图片 / 图片适配窗口。" /><LineBreak />
                    <Run Text="• 顶部刘海按钮：适配、图片调整、后台设置、关于；右上角悬停展开 📌 置顶与关闭按钮。" />
                </TextBlock>

                <TextBlock Text="请作者喝杯奶茶" FontWeight="SemiBold" Margin="0,16,0,6" />
                <StackPanel Orientation="Horizontal">
                    <Image Source="pack://application:,,,/Assets/donate.png" Width="132" Height="132"
                           HorizontalAlignment="Left" RenderOptions.BitmapScalingMode="HighQuality" />
                    <TextBlock Margin="14,0,0,0" MaxWidth="300" TextWrapping="Wrap"
                               VerticalAlignment="Center" Foreground="#FF4B5563" FontSize="12">
                        “你可以请作者喝杯奶茶提提神，鼓励作者贡献更多适用作品”
                    </TextBlock>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <TextBlock Text="MIT 免费开源" VerticalAlignment="Center" Foreground="#FF6B7280"
                       Margin="0,0,12,0" />
            <Button Content="关闭" Width="88" Padding="10,6" IsDefault="True" Click="Close_Click" />
        </StackPanel>
    </Grid>
</Window>
