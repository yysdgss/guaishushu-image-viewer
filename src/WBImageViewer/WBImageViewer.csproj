<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>GuaishushuViewer</AssemblyName>
    <RootNamespace>WBImageViewer</RootNamespace>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <!-- Single source of truth for the product version. AppInfo and both packaging
         scripts read this value; never duplicate it in code or batch files. -->
    <Version>1.4.0</Version>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <Product>怪叔叔看图</Product>
    <Authors>怪叔叔</Authors>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\app.ico" />
    <Resource Include="Assets\donate.png" />
  </ItemGroup>

</Project>
