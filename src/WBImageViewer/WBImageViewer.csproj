<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>怪叔叔看图</AssemblyName>
    <!-- Task Manager "Name" comes from the exe file, "Description" from FileDescription. -->
    <AssemblyTitle>怪叔叔看图</AssemblyTitle>
    <FileDescription>怪叔叔看图</FileDescription>
    <Company>怪叔叔</Company>
    <Copyright>怪叔叔</Copyright>
    <RootNamespace>WBImageViewer</RootNamespace>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <!-- Single source of truth for the product version. AppInfo and both packaging
         scripts read this value; never duplicate it in code or batch files. -->
    <Version>4.2.0</Version>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <Product>怪叔叔看图</Product>
    <Authors>怪叔叔</Authors>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\app.ico" />
    <Resource Include="Assets\app.png" />
    <Resource Include="Assets\donate.png" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Resources\pen.cur" LogicalName="WBImageViewer.Resources.pen.cur" />
    <EmbeddedResource Include="Resources\eraser.cur" LogicalName="WBImageViewer.Resources.eraser.cur" />
  </ItemGroup>

</Project>
