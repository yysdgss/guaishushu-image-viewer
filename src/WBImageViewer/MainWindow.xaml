<Window x:Class="WBImageViewer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="怪叔叔看图"
        Icon="Assets/app.ico"
        Width="760" Height="560"
        MinWidth="140" MinHeight="100"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="CanResize"
        AllowDrop="True"
        Topmost="True"
        ShowInTaskbar="True"
        Background="Transparent"
        Foreground="#FFE8EAED"
        UseLayoutRounding="True">

    <Window.Resources>
        <Style x:Key="IslandButton" TargetType="Button">
            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Foreground" Value="{StaticResource ThemeMutedTextBrush}" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontFamily" Value="Segoe UI Symbol" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#336CB6FF" />
                                <Setter Property="Foreground" Value="{StaticResource ThemeTextBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#666CB6FF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="LayerIcon" TargetType="Path">
            <Setter Property="Width" Value="14" />
            <Setter Property="Height" Value="14" />
            <Setter Property="Stretch" Value="None" />
            <Setter Property="StrokeThickness" Value="1.1" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="VerticalAlignment" Value="Top" />
        </Style>

        <Style x:Key="SmallButton" TargetType="Button">
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="Margin" Value="4,0,0,0" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="#FFE8EAED" />
            <Setter Property="Background" Value="#33FFFFFF" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>

        <Style x:Key="SliderLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="#FFC9D1DC" />
            <Setter Property="Margin" Value="0,6,0,0" />
        </Style>
    </Window.Resources>

    <WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0"
                            ResizeBorderThickness="8"
                            GlassFrameThickness="0"
                            UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Grid x:Name="Root" Background="#00000000" ClipToBounds="True" AllowDrop="True" Cursor="Arrow">
        <!-- Dedicated viewport: every zoom/pan is clipped to the current window client area.
             The image is positioned as a Canvas child so it can never enlarge the window layout. -->
        <Canvas x:Name="ImageViewport"
                Background="Transparent"
                ClipToBounds="True"
                SnapsToDevicePixels="False">
            <Image x:Name="ImageView"
                   Stretch="Fill"
                   Cursor="Arrow"
                   RenderOptions.BitmapScalingMode="HighQuality" />
        </Canvas>

        <!-- Stroke overlay and the SolidWorks-style annotation compass. Both are
             hit-test transparent so the viewport keeps receiving pointer input. -->
        <Canvas x:Name="AnnotationLayer" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                ClipToBounds="True" IsHitTestVisible="False" />
        <Canvas x:Name="CompassLayer" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                ClipToBounds="True" IsHitTestVisible="False" />

        <Border x:Name="Hint" HorizontalAlignment="Center" VerticalAlignment="Center"
                Padding="18,12" CornerRadius="12" IsHitTestVisible="False"
                Background="#D6353537" BorderBrush="#99FFFFFF" BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect Color="#000000" Opacity="0.35" BlurRadius="12" ShadowDepth="2" />
            </Border.Effect>
            <StackPanel>
                <TextBlock Text="拖入图片，或在资源管理器中双击图片文件"
                           FontSize="14" Foreground="{StaticResource ThemeTextBrush}"
                           HorizontalAlignment="Center" />
                <TextBlock Text="Ctrl + 鼠标右键拖出标注罗盘 · 底部小白条浏览图片"
                           FontSize="11" Foreground="{StaticResource ThemeAccentBrush}"
                           HorizontalAlignment="Center" Margin="0,6,0,0" />
            </StackPanel>
        </Border>

        <!-- Compact左下角工具徽标。选择项以向上伸出的小面板给出，悬停只做描边高亮。 -->
        <Grid HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="10,0,0,10">
            <Border x:Name="ToolBadgeMenu" Visibility="Collapsed" VerticalAlignment="Bottom"
                    Margin="0,0,0,40" MaxWidth="330" MaxHeight="260"
                    Background="#F2353537" BorderBrush="#FFFFFF" BorderThickness="1"
                    CornerRadius="10" Padding="8">
                <Border.Effect>
                    <DropShadowEffect Color="#000000" Opacity="0.5" BlurRadius="14" ShadowDepth="3" />
                </Border.Effect>
                <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="ToolBadgeMenuItems" />
                </ScrollViewer>
            </Border>

            <Border x:Name="ToolBadge" VerticalAlignment="Bottom" Padding="8,4" CornerRadius="6"
                    Background="#E6212328" BorderBrush="#66FFFFFF" BorderThickness="1"
                    Visibility="Collapsed" IsHitTestVisible="True" Cursor="Arrow">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="ToolBadgeName" Content="标注：指针" FontSize="11"
                            Foreground="{StaticResource ThemeTextBrush}" Background="Transparent" BorderThickness="0"
                            Padding="2,1" Cursor="Hand" ToolTip="线型 / 笔触选择"
                            Click="ToolBadgeName_Click" />
                    <Rectangle Width="1" Height="14" Fill="#44FFFFFF" Margin="4,0" />
                    <Button x:Name="ToolBadgeSize" Content="直径 3" FontSize="11"
                            Foreground="{StaticResource ThemeMutedTextBrush}" Background="Transparent" BorderThickness="0"
                            Padding="2,1" Cursor="Hand" ToolTip="线径选择"
                            Click="ToolBadgeSize_Click" />
                    <Button x:Name="ToolBadgeOpacity" Content="100%" FontSize="11"
                            Foreground="{StaticResource ThemeMutedTextBrush}" Background="Transparent" BorderThickness="0"
                            Padding="4,1,2,1" Cursor="Hand" ToolTip="透明度选择"
                            Click="ToolBadgeOpacity_Click" />
                    <Ellipse x:Name="ToolBadgeColorDot" Width="12" Height="12" Margin="5,0,1,0"
                             Fill="#FFFF5252" Stroke="#AAFFFFFF" StrokeThickness="1"
                             Cursor="Hand" MouseLeftButtonUp="ToolBadgeColorDot_Click"
                             ToolTip="颜色与调色板" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- Dynamic island: grows directly out of the window's top edge. The top edge sits at
             y=0 flush/tangent with the window border (no outward hairline "tail"), and the two
             top corners use the same radius as the two bottom gathering corners. -->
        <Grid x:Name="IslandHitArea"
              Width="200" Height="46"
              HorizontalAlignment="Center" VerticalAlignment="Top"
              Background="Transparent" SnapsToDevicePixels="False">
            <Grid x:Name="IslandRoot"
                  Width="200" Height="34"
                  HorizontalAlignment="Center" VerticalAlignment="Top">
                <Grid.Clip>
                    <RectangleGeometry x:Name="IslandClip" Rect="0,0,200,2" />
                </Grid.Clip>

                <Path x:Name="IslandShape" Stretch="Fill"
                      Data="M 10,0 H 190 C 182.2,0 176,5.4 176,12 V 22 C 176,28.6 169.8,34 164,34 H 36 C 30.2,34 24,28.6 24,22 V 12 C 24,5.4 17.8,0 10,0 Z"
                      Fill="#F2353537" Stroke="{StaticResource ThemeEdgeBrush}" StrokeThickness="1">
                    <Path.Effect>
                        <DropShadowEffect Color="#000000" Opacity="0.38" BlurRadius="8" ShadowDepth="2" />
                    </Path.Effect>
                </Path>

                <!-- Collapsed hairline matches the island top-edge width (10..190). -->
                <Rectangle x:Name="IslandHairline" Height="2" Margin="10,0,10,0"
                           VerticalAlignment="Top" RadiusX="1" RadiusY="1" Fill="#FFFFFF" />

                <StackPanel x:Name="IslandButtons"
                            Orientation="Horizontal" HorizontalAlignment="Center"
                            VerticalAlignment="Center" Margin="0,1,0,0"
                            Opacity="0" IsHitTestVisible="False">
                    <Button x:Name="WindowToImageButton" Style="{StaticResource IslandButton}" Width="22" Height="22" FontSize="12"
                            ToolTip="窗口适配图片：以图片大小为准（Shift+Ctrl+Alt+R）" Click="WindowToImageButton_Click">
                        <!-- Two-layer logo: the picture (target) is the bright top layer,
                             the window (source) is the dim layer behind it. -->
                        <Grid Width="18" Height="18">
                            <Path Style="{StaticResource LayerIcon}"
                                  Data="M1,2.5 H13 V11.5 H1 Z M1,5 H13"
                                  Stroke="#FF7A8290" Fill="Transparent" />
                            <Path Style="{StaticResource LayerIcon}" Margin="4,4,0,0"
                                  Data="M1,2.5 H13 V11.5 H1 Z M10,4.7 H11.6 V6.3 H10 Z M1.8,10.6 L5.2,7.2 L7.8,9.6 L10.4,6.6 L13.2,10.8"
                                  Stroke="#FFFFFF" Fill="#F2353537" />
                        </Grid>
                    </Button>
                    <Button x:Name="ImageToWindowButton" Style="{StaticResource IslandButton}" Width="22" Height="22" FontSize="12"
                            ToolTip="图片适配窗口：以窗口大小为准（Shift+Ctrl+Alt+S）" Click="ImageToWindowButton_Click">
                        <!-- Two-layer logo: the window (target) is the bright top layer,
                             the picture (source) is the dim layer behind it. -->
                        <Grid Width="18" Height="18">
                            <Path Style="{StaticResource LayerIcon}"
                                  Data="M1,2.5 H13 V11.5 H1 Z M10,4.7 H11.6 V6.3 H10 Z M1.8,10.6 L5.2,7.2 L7.8,9.6 L10.4,6.6 L13.2,10.8"
                                  Stroke="#FF7A8290" Fill="Transparent" />
                            <Path Style="{StaticResource LayerIcon}" Margin="4,4,0,0"
                                  Data="M1,2.5 H13 V11.5 H1 Z M1,5 H13"
                                  Stroke="#FFFFFF" Fill="#F2353537" />
                        </Grid>
                    </Button>
                    <Button x:Name="AdjustButton" Style="{StaticResource IslandButton}" Width="22" Height="22" FontSize="12" Content="◑"
                            ToolTip="图片调整" Click="AdjustButton_Click" />
                    <Button x:Name="ShotButton" Style="{StaticResource IslandButton}" Width="22" Height="22" FontSize="12" Content="✂"
                            ToolTip="屏幕截图" Click="ShotButton_Click">
                        <Button.ContextMenu>
                            <ContextMenu x:Name="ShotMenu" Background="#F2353537" BorderBrush="#FFFFFF" BorderThickness="1"
                                         Foreground="#FFE8EAED">
                                <MenuItem Header="截全屏" Click="ShotFull_Click" />
                                <MenuItem Header="截指定窗口" Click="ShotWindow_Click" />
                                <MenuItem Header="截矩形区" Click="ShotRegion_Click" />
                                <MenuItem Header="自由绘制封闭区" Click="ShotFree_Click" />
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                    <Button x:Name="SettingsButton" Style="{StaticResource IslandButton}" Width="22" Height="22" FontSize="12" Content="⚙"
                            ToolTip="后台设置" Click="SettingsButton_Click" />
                    <Button x:Name="AboutButton" Style="{StaticResource IslandButton}" Width="22" Height="22" FontSize="12" Content="i"
                            ToolTip="关于" Click="AboutButton_Click" />
                </StackPanel>
            </Grid>
        </Grid>

        <!-- Adjustment drawer. -->
        <Border x:Name="AdjustPanel"
                Visibility="Collapsed"
                Width="232"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Margin="0,48,8,0"
                Padding="12,10,12,12"
                CornerRadius="12"
                Background="#E6161A20"
                BorderBrush="#33FFFFFF"
                BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect Color="#000000" Opacity="0.5" BlurRadius="14" ShadowDepth="3" />
            </Border.Effect>
            <StackPanel>
                <DockPanel>
                    <TextBlock Text="图片调整" FontSize="12" FontWeight="SemiBold" DockPanel.Dock="Left" />
                    <Button Content="×" Width="22" Height="22" Padding="0" HorizontalAlignment="Right"
                            Style="{StaticResource IslandButton}" Click="CloseAdjust_Click" />
                </DockPanel>
                <TextBlock Style="{StaticResource SliderLabel}" Text="亮度 0" x:Name="BrightnessLabel" />
                <Slider x:Name="BrightnessSlider" Minimum="-100" Maximum="100" ValueChanged="Adjustment_Changed" />
                <TextBlock Style="{StaticResource SliderLabel}" Text="对比度 0" x:Name="ContrastLabel" />
                <Slider x:Name="ContrastSlider" Minimum="-100" Maximum="100" ValueChanged="Adjustment_Changed" />
                <TextBlock Style="{StaticResource SliderLabel}" Text="饱和度 0" x:Name="SaturationLabel" />
                <Slider x:Name="SaturationSlider" Minimum="-100" Maximum="100" ValueChanged="Adjustment_Changed" />
                <TextBlock Style="{StaticResource SliderLabel}" Text="去噪 0" x:Name="DenoiseLabel" />
                <Slider x:Name="DenoiseSlider" Minimum="0" Maximum="100" ValueChanged="Adjustment_Changed" />
                <TextBlock Style="{StaticResource SliderLabel}" Text="锐化 0" x:Name="SharpenLabel" />
                <Slider x:Name="SharpenSlider" Minimum="0" Maximum="100" ValueChanged="Adjustment_Changed" />
                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                    <Button Content="智能优化" Style="{StaticResource SmallButton}" Width="92" Margin="0"
                            Click="SmartPreset_Click" />
                    <Button Content="还原原始" Style="{StaticResource SmallButton}" Width="92" Click="ResetAdjust_Click" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Left/right page-turn zones: translucent half-arcs hugging the window edges.
             The transparent border is the (tall) hit target; the arc is only its skin. -->
        <Border x:Name="PrevZone" Width="72" Height="228" HorizontalAlignment="Left" VerticalAlignment="Center"
                Background="#00000000" Opacity="0.22" Cursor="Hand" ToolTip="上一张"
                MouseEnter="NavZone_Enter" MouseLeave="NavZone_Leave" MouseLeftButtonUp="PrevZone_Click">
            <Grid>
                <Path x:Name="PrevArc" Stretch="Fill"
                      Data="M0,0 C 66,32 66,196 0,228 L0,0 Z"
                      Fill="#8A353537" Stroke="{StaticResource ThemeEdgeBrush}" StrokeThickness="1"
                      IsHitTestVisible="False" />
                <TextBlock Text="‹" FontSize="42" Foreground="{StaticResource ThemeTextBrush}"
                           HorizontalAlignment="Left" VerticalAlignment="Center" Margin="12,0,0,3"
                           IsHitTestVisible="False" />
            </Grid>
        </Border>
        <Border x:Name="NextZone" Width="72" Height="228" HorizontalAlignment="Right" VerticalAlignment="Center"
                Background="#00000000" Opacity="0.22" Cursor="Hand" ToolTip="下一张"
                MouseEnter="NavZone_Enter" MouseLeave="NavZone_Leave" MouseLeftButtonUp="NextZone_Click">
            <Grid>
                <Path x:Name="NextArc" Stretch="Fill"
                      Data="M72,0 C 6,32 6,196 72,228 L72,0 Z"
                      Fill="#8A353537" Stroke="{StaticResource ThemeEdgeBrush}" StrokeThickness="1"
                      IsHitTestVisible="False" />
                <TextBlock Text="›" FontSize="42" Foreground="{StaticResource ThemeTextBrush}"
                           HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,3"
                           IsHitTestVisible="False" />
            </Grid>
        </Border>

        <!-- Bottom filmstrip island: a small white bar grows into a translucent carousel. -->
        <Grid x:Name="FilmstripHost" Width="620" Height="102" HorizontalAlignment="Center" VerticalAlignment="Bottom"
              IsHitTestVisible="False" Opacity="0" ClipToBounds="False"
              MouseLeave="FilmstripHost_MouseLeave" MouseMove="FilmstripHost_MouseMove">
            <Grid.RenderTransform>
                <TranslateTransform x:Name="FilmstripSlide" Y="98" />
            </Grid.RenderTransform>
            <Border x:Name="FilmstripPanel" Height="96" VerticalAlignment="Bottom" CornerRadius="18,18,0,0"
                    Background="#E6353537" BorderBrush="#88FFFFFF" BorderThickness="1,1,0,0"
                    ClipToBounds="False">
                <Border.Effect>
                    <DropShadowEffect Color="#000000" Opacity="0.45" BlurRadius="14" ShadowDepth="2" />
                </Border.Effect>
                <Grid Margin="10,4,10,8">
                    <ListBox x:Name="FilmstripList" Background="Transparent" BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Hidden"
                             ScrollViewer.VerticalScrollBarVisibility="Disabled"
                             SelectionChanged="FilmstripList_SelectionChanged"
                             PreviewMouseWheel="FilmstripList_PreviewMouseWheel">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Margin" Value="5,0" />
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="BorderThickness" Value="0" />
                                <Setter Property="RenderTransformOrigin" Value="0.5,1" />
                                <Setter Property="ClipToBounds" Value="False" />
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Width="62" Height="58" CornerRadius="8" BorderThickness="2"
                                        BorderBrush="{Binding Brush}" Background="#22161920">
                                    <Image Source="{Binding Thumbnail}" Stretch="UniformToFill"
                                           IsHitTestVisible="False" ClipToBounds="True" />
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock x:Name="FilmstripCounter" Text="0 / 0" Foreground="{StaticResource ThemeMutedTextBrush}"
                               FontSize="10" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-2,2,0" />
                </Grid>
            </Border>
        </Grid>
        <!-- The visible 4px white trigger sits inside a taller transparent hit area so the
             bottom WindowChrome resize border cannot swallow the hover. -->
        <Grid x:Name="FilmstripBarHit" Width="220" Height="28" HorizontalAlignment="Center" VerticalAlignment="Bottom"
              Background="#00000000" Cursor="Hand" ToolTip="悬停浏览本目录图片"
              MouseEnter="FilmstripBar_MouseEnter" MouseLeave="FilmstripBar_MouseLeave">
            <Border x:Name="FilmstripBar" Width="120" Height="4" VerticalAlignment="Bottom"
                    CornerRadius="2,2,0,0" Background="#D6FFFFFF" IsHitTestVisible="False" />
        </Grid>

        <!-- Top-right slide-out panel. One island-shaped surface carries both
             actions; the pushpin and close are two buttons hosted on that panel. -->
        <Grid x:Name="CloseHost" Width="62" Height="30" HorizontalAlignment="Right"
              VerticalAlignment="Top" Background="Transparent" ClipToBounds="True">
            <Grid x:Name="CloseStrip" HorizontalAlignment="Right" VerticalAlignment="Top">
                <Grid.RenderTransform>
                    <TranslateTransform x:Name="CloseTransform" Y="-32" />
                </Grid.RenderTransform>

                <Grid x:Name="ActionPanel" Width="62" Height="30">
                    <Path x:Name="ActionPanelShape" Stretch="Fill"
                          Data="M 2,0 H 60 C 58.2,0 56,1.8 56,4 V 22 C 56,26.4 52.4,30 48,30 H 14 C 9.6,30 6,26.4 6,22 V 4 C 6,1.8 3.8,0 2,0 Z"
                          Stroke="#FFFFFF" StrokeThickness="1">
                        <Path.Style>
                            <Style TargetType="Path">
                                <Setter Property="Fill" Value="#F2353537" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Tag, ElementName=PinButton}" Value="Pinned">
                                        <Setter Property="Fill" Value="#F23A3D40" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Path.Style>
                        <Path.Effect>
                            <DropShadowEffect Color="#000000" Opacity="0.38" BlurRadius="8" ShadowDepth="2" />
                        </Path.Effect>
                    </Path>

                    <Grid Margin="2,0,2,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="31" />
                            <ColumnDefinition Width="27" />
                        </Grid.ColumnDefinitions>
                        <Rectangle Grid.Column="1" Width="1" Margin="0,6,0,6"
                                   HorizontalAlignment="Left" Fill="#33FFFFFF" />

                        <Button x:Name="PinButton" Grid.Column="0" Width="31" Height="30"
                                Focusable="False" Cursor="Hand" Click="PinButton_Click"
                                Tag="Pinned" ToolTip="取消置顶 (Shift+Ctrl+Alt+T)">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Grid Background="Transparent">
                                        <Ellipse x:Name="PinHalo" Width="19" Height="19"
                                                 HorizontalAlignment="Center" VerticalAlignment="Center"
                                                 Fill="{StaticResource ThemeAccentBrush}" Opacity="0.42">
                                            <Ellipse.Effect>
                                                <BlurEffect Radius="6" />
                                            </Ellipse.Effect>
                                        </Ellipse>
                                        <TextBlock x:Name="PinGlyph" Text="📌"
                                                   FontFamily="Segoe UI Emoji, Segoe UI Symbol"
                                                   FontSize="16" HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" Margin="0,-1,0,0"
                                                   RenderTransformOrigin="0.5,0.6" Opacity="1">
                                            <TextBlock.RenderTransform>
                                                <TransformGroup>
                                                    <RotateTransform x:Name="PinRotate" Angle="0" />
                                                    <TranslateTransform x:Name="PinLift" Y="0" />
                                                </TransformGroup>
                                            </TextBlock.RenderTransform>
                                        </TextBlock>
                                    </Grid>
                                    <ControlTemplate.Triggers>
                                        <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" Value="Pinned">
                                            <Setter TargetName="PinGlyph" Property="Opacity" Value="1" />
                                            <Setter TargetName="PinHalo" Property="Opacity" Value="0.42" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" Value="Unpinned">
                                            <Setter TargetName="PinGlyph" Property="Opacity" Value="0.45" />
                                            <Setter TargetName="PinHalo" Property="Opacity" Value="0" />
                                        </DataTrigger>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource TemplatedParent}}" Value="True" />
                                                <Condition Binding="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" Value="Pinned" />
                                            </MultiDataTrigger.Conditions>
                                            <Setter TargetName="PinHalo" Property="Opacity" Value="0.85" />
                                        </MultiDataTrigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <Button x:Name="CloseButton" Grid.Column="1" Width="27" Height="30"
                                Focusable="False" Cursor="Hand" Click="CloseButton_Click"
                                ToolTip="关闭窗口">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Grid Background="Transparent">
                                        <Rectangle x:Name="CloseHover" RadiusX="5" RadiusY="5"
                                                   Fill="#00FFFFFF" />
                                        <TextBlock x:Name="CloseGlyph" Text="×" FontSize="18"
                                                   Foreground="{StaticResource ThemeTextBrush}" HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" Margin="0,-1,0,0" />
                                    </Grid>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="CloseHover" Property="Fill" Value="#336CB6FF" />
                                            <Setter TargetName="CloseGlyph" Property="Foreground" Value="#FFFFFFFF" />
                                        </Trigger>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter TargetName="CloseHover" Property="Fill" Value="#666CB6FF" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Grid>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Window>
