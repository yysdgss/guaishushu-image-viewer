<Window x:Class="WBImageViewer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="该怪叔叔看图"
        Width="760" Height="560"
        MinWidth="140" MinHeight="100"
        WindowStyle="None"
        ResizeMode="CanResize"
        AllowDrop="True"
        Topmost="True"
        ShowInTaskbar="True"
        Background="#FF101216"
        Foreground="#FFE8EAED"
        UseLayoutRounding="True">

    <Window.Resources>
        <Style x:Key="IslandButton" TargetType="Button">
            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Foreground" Value="#FFD7DEE8" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontFamily" Value="Segoe UI Symbol" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#33FFFFFF" />
                                <Setter Property="Foreground" Value="#FFFFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#44FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SmallButton" TargetType="Button">
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="Margin" Value="4,0,0,0" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="#FFE8EAED" />
            <Setter Property="Background" Value="#33FFFFFF" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>

        <Style x:Key="SliderLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="#FFC9D1DC" />
            <Setter Property="Margin" Value="0,6,0,0" />
        </Style>
    </Window.Resources>

    <WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0"
                            ResizeBorderThickness="8"
                            GlassFrameThickness="0"
                            UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Grid x:Name="Root" Background="#FF101216" ClipToBounds="True" AllowDrop="True">
        <Image x:Name="ImageView"
               Stretch="Fill"
               HorizontalAlignment="Center"
               VerticalAlignment="Center"
               RenderOptions.BitmapScalingMode="HighQuality">
            <Image.RenderTransform>
                <TranslateTransform x:Name="ImageTranslate" X="0" Y="0" />
            </Image.RenderTransform>
        </Image>

        <TextBlock x:Name="Hint"
                   Text="拖入图片，或在资源管理器中双击图片文件"
                   FontSize="14"
                   Foreground="#FF7A8290"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   IsHitTestVisible="False" />

        <!-- Dynamic-island style control strip. -->
        <Border x:Name="Island"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Margin="0,7,0,0"
                Height="34"
                CornerRadius="4,17,17,4"
                Background="#CC161A20"
                BorderBrush="#22FFFFFF"
                BorderThickness="1"
                Padding="6,2"
                SnapsToDevicePixels="False">
            <Border.Effect>
                <DropShadowEffect Color="#000000" Opacity="0.45" BlurRadius="10" ShadowDepth="2" />
            </Border.Effect>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="PinButton" Style="{StaticResource IslandButton}" Content="⌃"
                        ToolTip="切换置顶 (Shift+Ctrl+Alt+T)" Click="PinButton_Click" />
                <Button x:Name="WindowToImageButton" Style="{StaticResource IslandButton}" Content="⤢"
                        ToolTip="窗口适配图片 (Shift+Ctrl+Alt+R)" Click="WindowToImageButton_Click" />
                <Button x:Name="ImageToWindowButton" Style="{StaticResource IslandButton}" Content="⤡"
                        ToolTip="图片适配窗口 (Shift+Ctrl+Alt+S)" Click="ImageToWindowButton_Click" />
                <Button x:Name="AdjustButton" Style="{StaticResource IslandButton}" Content="◑"
                        ToolTip="图片调整" Click="AdjustButton_Click" />
                <Button x:Name="SettingsButton" Style="{StaticResource IslandButton}" Content="⚙"
                        ToolTip="后台设置" Click="SettingsButton_Click" />
                <Button x:Name="AboutButton" Style="{StaticResource IslandButton}" Content="i"
                        ToolTip="关于" Click="AboutButton_Click" />
            </StackPanel>
        </Border>

        <!-- Adjustment drawer. -->
        <Border x:Name="AdjustPanel"
                Visibility="Collapsed"
                Width="232"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Margin="0,48,8,0"
                Padding="12,10,12,12"
                CornerRadius="12"
                Background="#E6161A20"
                BorderBrush="#33FFFFFF"
                BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect Color="#000000" Opacity="0.5" BlurRadius="14" ShadowDepth="3" />
            </Border.Effect>
            <StackPanel>
                <DockPanel>
                    <TextBlock Text="图片调整" FontSize="12" FontWeight="SemiBold" DockPanel.Dock="Left" />
                    <Button Content="×" Width="22" Height="22" Padding="0" HorizontalAlignment="Right"
                            Style="{StaticResource IslandButton}" Click="CloseAdjust_Click" />
                </DockPanel>
                <TextBlock Style="{StaticResource SliderLabel}" Text="亮度 0" x:Name="BrightnessLabel" />
                <Slider x:Name="BrightnessSlider" Minimum="-100" Maximum="100" ValueChanged="Adjustment_Changed" />
                <TextBlock Style="{StaticResource SliderLabel}" Text="对比度 0" x:Name="ContrastLabel" />
                <Slider x:Name="ContrastSlider" Minimum="-100" Maximum="100" ValueChanged="Adjustment_Changed" />
                <TextBlock Style="{StaticResource SliderLabel}" Text="饱和度 0" x:Name="SaturationLabel" />
                <Slider x:Name="SaturationSlider" Minimum="-100" Maximum="100" ValueChanged="Adjustment_Changed" />
                <TextBlock Style="{StaticResource SliderLabel}" Text="去噪 0" x:Name="DenoiseLabel" />
                <Slider x:Name="DenoiseSlider" Minimum="0" Maximum="100" ValueChanged="Adjustment_Changed" />
                <TextBlock Style="{StaticResource SliderLabel}" Text="锐化 0" x:Name="SharpenLabel" />
                <Slider x:Name="SharpenSlider" Minimum="0" Maximum="100" ValueChanged="Adjustment_Changed" />
                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                    <Button Content="智能优化" Style="{StaticResource SmallButton}" Width="92" Margin="0"
                            Click="SmartPreset_Click" />
                    <Button Content="还原原始" Style="{StaticResource SmallButton}" Width="92" Click="ResetAdjust_Click" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Close control slides down from the top-right edge on hover. -->
        <Grid x:Name="CloseHost" Width="30" Height="40" HorizontalAlignment="Right"
              VerticalAlignment="Top" Background="Transparent" ClipToBounds="True">
            <Button x:Name="CloseButton" Width="26" Height="26" HorizontalAlignment="Center"
                    VerticalAlignment="Top" Content="×" FontSize="17" Foreground="#FFE8EAED"
                    Focusable="False" Cursor="Hand" Click="CloseButton_Click"
                    ToolTip="关闭窗口">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="#CCB42B2B" CornerRadius="0,0,6,6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#FFE04B4B" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
                <Button.RenderTransform>
                    <TranslateTransform x:Name="CloseTransform" Y="-30" />
                </Button.RenderTransform>
            </Button>
        </Grid>
    </Grid>
</Window>
